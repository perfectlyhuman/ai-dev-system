{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://perfectlyhuman.dev/ai-dev-system/v3/access.schema.json",
  "title": "AI Dev System project access request manifest",
  "description": "Non-secret central credential routes and capabilities requested by one project.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project", "requests"],
  "properties": {
    "schema_version": { "const": 1 },
    "project": { "type": "string", "minLength": 1 },
    "requests": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/request" }
    }
  },
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["credential", "capabilities"],
      "properties": {
        "credential": { "type": "string", "minLength": 1 },
        "resource": { "type": "string", "minLength": 1 },
        "capabilities": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    }
  }
}
